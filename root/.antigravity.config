{
  "name": "REEF | Ocean Conservation Platform",
  "version": "1.0.0",
  "ide": "Antigravity IDE",
  "frameworks": {
    "frontend": "React 18 + Tailwind CSS 3 + Three.js (R3F)",
    "backend": "FastAPI (Python 3.10+)"
  },
  "theme": "KABOOM! 90s Pop-Art / Neo-Brutalist Comic Book",
  "monorepo": true,
  "settings": {
    "telemetry": false,
    "3d_proximity_scale": {
      "interactive_depth_z": 0.0,
      "background_depth_z": -5.0
    }
  }
}
